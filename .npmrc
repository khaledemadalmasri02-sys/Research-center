auto-install-peers=false
strict-peer-dependencies=false

# pnpm's verify-deps-before-run triggers an implicit `pnpm install` whenever
# node_modules is considered stale. On a non-interactive run (CI, agents, CI
# containers) that install cannot prompt, so pnpm PURGES the modules directory
# and then aborts with ERR_PNPM_ABORTED_REMOVE_MODULES_DIR_NO_TTY -- leaving
# every workspace with empty node_modules and no .bin symlinks. Set this false
# and run installs explicitly instead.
verify-deps-before-run=false
