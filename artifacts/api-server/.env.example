# Database Configuration
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/mednexus

# Server Configuration
PORT=3004
SESSION_SECRET=your-session-secret-here-change-in-production

# Authentication (for admin access)
APP_USERNAME=admin
APP_PASSWORD_HASH=$2b$10$your-bcrypt-hash-here

# S3-Compatible Storage Configuration (MinIO)
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_BUCKET=mednexus
S3_FORCE_PATH_STYLE=true
S3_SIGNED_URL_EXPIRES_SECONDS=300

# Object Storage Paths
# Format: /{bucket-name} (add more paths separated by commas for multiple buckets)
PUBLIC_OBJECT_SEARCH_PATHS=/mednexus
PRIVATE_OBJECT_DIR=/mednexus

# IMPORTANT: The bucket must be created before uploading images
# Run this to create the bucket (requires mc CLI or use MinIO Console):
# mc mb myminio/mednexus
# Or via API: POST /storage/ensure-bucket (authenticated)

# Optional: File Upload Limits
MAX_IMAGE_SIZE_MB=100