# api-server (Express) configuration — the single documented source of truth
# for every variable this service reads. Do not duplicate these into the
# repo-root .env.example; that file only carries docker-compose + deploy-script
# inputs.
#
#   cp .env.example .env        # scripts/dev.sh loads this file automatically
#
# Every value below is a dev-safe default. Anything marked PRODUCTION has no
# acceptable default and must be set explicitly before deploying.

# ---- Runtime ------------------------------------------------------------------
# "development" | "production". In production the server refuses to start
# without ALLOWED_ORIGINS / SESSION_SECRET, marks session cookies Secure, and
# switches the session cookie name to "__Host-rc_sid".
# PRODUCTION: production. scripts/research-deploy.sh sets it (and refuses a
# localhost DATABASE_URL while it is production).
NODE_ENV=development

# TCP port for the API. Repo-wide scheme: 4000 api-server, 4003 mockup-sandbox,
# 4004 research-data SPA (see README "Ports"). Required — the server throws if
# PORT is missing.
PORT=4000

# Session signing secret. 32+ random bytes (e.g.
# `node -e "console.log(crypto.randomBytes(32).toString('base64url'))"`).
# The code falls back to "dev-secret-change-me" if unset — that fallback is
# refused under NODE_ENV=production.
# PRODUCTION: required, unique, and rotated if it ever hit a shared machine.
SESSION_SECRET=your-session-secret-here-change-in-production

# ---- Database -----------------------------------------------------------------
# PostgreSQL connection string. Use the Docker service name when the api-server
# runs inside compose (`postgres:5432`), localhost when it runs on the host.
# PRODUCTION: never localhost/127.0.0.1 — that is the dev database.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/mednexus

# Database used by the test suite only (artifacts/api-server/test/setup-env.ts).
# Falls back to DATABASE_URL when unset, which means tests can wipe dev data:
# point this at a throwaway database.
# TEST_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/mednexus_test

# ---- Logging ------------------------------------------------------------------
# pino log level: trace | debug | info | warn | error | fatal | silent.
LOG_LEVEL=info

# ---- CORS / Origin policy (REQUIRED in production) ---------------------------
# Comma-separated list of origins allowed to issue credentialed cross-site
# requests. Must include the SPA's public origin (e.g. https://research-center.fit)
# and any subdomain that serves the SPA. The Worker rewrites Origin before
# proxying, so api-server's CORS only gates direct browser→api-server traffic
# (local dev, health probes). NODE_ENV=production refuses to start without this.
ALLOWED_ORIGINS=http://localhost:4003,http://localhost:4004,http://127.0.0.1:4003,http://127.0.0.1:4004

# Escape hatch for cloud-IDE dev URLs that change every preview. Refuses
# cross-origin state-changing requests via the same-origin guard. Do not use
# in production.
SECURE_CORS=allow-any

# ---- Session cookie hardening ------------------------------------------------
# SESSION_COOKIE_SAMESITE: "lax" (default), "strict", or "none".
#   * "lax"   — the new default. Blocks CSRF on cross-site sub-requests.
#   * "strict"— strongest. Drops the cookie even on top-level navigations
#                from external sites. Use for admin deployments where you
#                don't want the session attached to links from email.
#   * "none"  — required only if the browser hits the api-server directly
#                from a different origin (i.e. NOT through the Worker
#                proxy). Set this if you do that.
# In production the cookie name becomes "__Host-rc_sid" automatically,
# which enforces Secure + Path=/ + no Domain at the browser.
SESSION_COOKIE_SAMESITE=lax

# Cookie Domain attribute. Defaults to ".research-center.fit" under
# NODE_ENV=production and to "no Domain" (host-only) otherwise. Set this only
# if you serve the SPA from a different registrable domain; it must then be a
# parent domain of the request host, never a public suffix.
# PRODUCTION: leave unset (host-only + __Host- prefix) unless cross-subdomain
# sharing is required.
# SESSION_COOKIE_DOMAIN=.research-center.fit

# Force the Secure cookie attribute outside production (e.g. when TLS
# terminates at a proxy in front of a staging box). Implied by NODE_ENV=
# production, so leave it unset there.
# FORCE_SECURE_COOKIE=true

# ---- Authentication (admin access) -------------------------------------------
APP_USERNAME=admin
# Bcrypt hash of the admin password. Generate with:
#   node -e "const b=require('bcryptjs');process.stdout.write(b.hashSync(process.argv[1],12))" 'your-password'
# scripts/research-deploy.sh hashes ADMIN_PASSWORD and passes it in; it stores
# only the hash.
APP_PASSWORD_HASH=$2b$10$your-bcrypt-hash-here

# Public URL of this application, sent as the HTTP-Referer header on Groq /
# OpenRouter voice requests (both providers require it). Also a sensible
# default for links in transactional email.
# PRODUCTION: https://research-center.fit
APP_PUBLIC_URL=http://localhost:4004

# ---- S3-Compatible Storage Configuration (MinIO) ------------------------------
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
# Dev-only. MinIO's published defaults; docker-compose.yml binds MinIO to
# 127.0.0.1 so they cannot be reached off-host, but they must never be used
# for a real bucket. scripts/research-deploy.sh refuses to start with them.
# PRODUCTION: a dedicated, non-default key pair.
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_BUCKET=mednexus
S3_FORCE_PATH_STYLE=true
S3_SIGNED_URL_EXPIRES_SECONDS=300

# Object Storage Paths
# Both of these are LEGACY read-path lookups. New code writes only to
# <bucket>/radiology/<object-id>. The api-server uses these vars to
# resolve objects that were uploaded under the historical
# /mednexus/... or /objects/... layout. If your bucket has no legacy
# data, set both to empty strings — but PRIVATE_OBJECT_DIR is required, the
# storage layer throws without it.
# See STORAGE.md (in the repo root) for the canonical scheme. These two values
# are also mirrored in the repo-root .env.example because scripts/dev.sh loads
# the root .env; keep the two copies identical.
PUBLIC_OBJECT_SEARCH_PATHS=/mednexus
PRIVATE_OBJECT_DIR=/mednexus

# IMPORTANT: The bucket must be created before uploading images
# Run this to create the bucket (requires mc CLI or use MinIO Console):
# mc mb myminio/mednexus
# Or via API: POST /storage/ensure-bucket (authenticated)

# ---- Request limits -----------------------------------------------------------
# Optional: File Upload Limits.
# NOTE: MAX_IMAGE_SIZE_MB is not read by any source file today — it is kept as
# documentation of the intended ceiling. The value actually enforced today is
# JSON_BODY_LIMIT below plus the per-route S3 limits.
MAX_IMAGE_SIZE_MB=100

# ---- Body size limit (P1.3) --------------------------------------------------
# Default 1 MB. The api-server rejects larger JSON bodies with 413.
# Bumping this without also raising the per-IP rate limits on
# /api/storage/* and /api/analysis/* would re-open the DoS vector
# that the old 50 MB default had. Don't raise this in production
# unless you know what you're doing.
JSON_BODY_LIMIT=1mb

# ---- OTP length (P1.4) ------------------------------------------------------
# Default 6 digits. 4 digits (the previous default) is borderline for
# medical data. Don't set this below 6 in production without a
# documented threat-model exception in SECURITY.md.
OTP_LENGTH=6

# ---- Email (SMTP2GO SMTP for sending + Cloudflare Email Routing for receive) ----
# Sending: free SMTP2GO SMTP (1000/mo). Create a free SMTP2GO account, verify
# research-center.fit (add the 3 CNAME records SMTP2GO gives you to Cloudflare
# DNS for SPF/DKIM), create an SMTP key, and paste it below. Without SMTP_*
# (or the Cloudflare Email Sending pair below) sendEmail() no-ops and OTP /
# notification mail is never delivered.
SMTP_HOST=mail.smtp2go.com
SMTP_PORT=2525
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
# From address (transactional mail). Must be a verified sender in the SMTP
# provider. nologin/auth mail is sent from noreply; replies are routed to
# MAIL_REPLY_TO so users can still reach a human.
SMTP_FROM=noreply@research-center.fit
MAIL_FROM=noreply@research-center.fit
MAIL_FROM_NAME=Research Center
MAIL_REPLY_TO=support@research-center.fit

# Alternative to SMTP_*: Cloudflare Email Sending. Set BOTH to use it; they take
# effect when SMTP_USER is empty. CF_ACCOUNT_ID is the account id from the
# Cloudflare dashboard (not a secret); CF_EMAIL_TOKEN is a scoped API token with
# Email Sending permission and IS a secret.
# CF_ACCOUNT_ID=
# CF_EMAIL_TOKEN=

# Footer link target. Must serve a working unsubscribe page that honours the
# List-Unsubscribe header (RFC 8058 one-click POST). Used by Gmail/Yahoo to
# confirm legitimate bulk senders.
MAIL_UNSUBSCRIBE_URL=https://research-center.fit/unsubscribe
# Worker URL used by the api-server to check whether a recipient has
# previously unsubscribed. Should point at the deployed Worker (typically the
# same origin as MAIL_UNSUBSCRIBE_URL). Leave empty to skip the check.
MAIL_UNSUBSCRIBE_LOOKUP_URL=https://research-center.fit
# Optional shared secret. If set, must match MAIL_UNSUBSCRIBE_LOOKUP_TOKEN on
# the Worker side (env.UNSUBSCRIBE_STATUS_TOKEN). Recommended in production.
MAIL_UNSUBSCRIBE_LOOKUP_TOKEN=
# How long to wait for the lookup before failing-open (ms). Default 800.
MAIL_UNSUBSCRIBE_TIMEOUT_MS=800
# How long to cache a "not unsubscribed" answer per recipient (ms). Default 60s.
MAIL_UNSUBSCRIBE_CACHE_TTL_MS=60000

# Receiving: shared secret the Worker POSTs to /api/inbound-email.
# Must match the Worker's INBOUND_EMAIL_SECRET secret (wrangler secret put).
INBOUND_EMAIL_SECRET=

# ---- OAuth sign-in ----------------------------------------------------------
# Google: create an OAuth client at https://console.cloud.google.com/apis/credentials.
#   Redirect URI: https://research-center.fit/api/auth/oauth/google/callback
# NEVER commit real values. A committed client secret must be treated as
# compromised and rotated — anyone with repo history can mint tokens with it.
# The same keys were previously committed in the repo-root .env.example; they
# were removed there and must be rotated in the GCP console.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://research-center.fit/api/auth/oauth/google/callback

# Apple: create a Services ID at https://developer.apple.com/account/.
#   Redirect URI: https://research-center.fit/api/auth/oauth/apple/callback
APPLE_CLIENT_ID=
APPLE_CLIENT_SECRET=
APPLE_REDIRECT_URI=https://research-center.fit/api/auth/oauth/apple/callback

# ---- AI / voice transcription (optional) -------------------------------------
# Server-side keys for the /api/voice route. Both are secrets: they must never
# reach the browser bundle. Leave empty to disable the route.
# GROQ_API_KEY=
# OPENROUTER_API_KEY=

# ---- Tour media (optional) ---------------------------------------------------
# Directory served by the in-product tour route. Defaults to
# <cwd>/data/tour-media. Point it at research/public/tour so the deployed Worker
# assets are used.
# TOUR_MEDIA_DIR=./data/tour-media

# ---- Reverse-proxy trust (SECURITY) -----------------------------------------
# `clientIp()` (src/lib/security.ts) derives the client address used by EVERY
# per-IP rate limit and account lockout. It honours `X-Forwarded-For` only when
# the immediate socket peer appears in this list; otherwise it uses the socket
# address. Leaving this empty means a forged XFF header cannot rotate the
# bucket — correct, but it also means every request looks like it comes from the
# proxy, so all clients share one rate-limit bucket.
#
# In production set this to the address(es) that actually terminate TLS in front
# of this process: the Cloudflare tunnel / reverse proxy. Comma-separated, exact
# string match against req.socket.remoteAddress (IPv4 or IPv6). Fails closed:
# an unparseable or absent peer never trusts the header.
# TRUSTED_PROXY_CIDRS=

# ---- OTP hashing (SECURITY) --------------------------------------------------
# Salt for the login/signup OTP digest. OTPs are stored as
# `sha256$<salt>$<HMAC-SHA256(salt + code)>`, not bcrypt: a 6-digit code is
# high-entropy and expires in minutes, so a KDF buys nothing but event-loop
# latency. Passwords still use bcrypt. Falls back to SESSION_SECRET when unset;
# set it explicitly so rotating one does not invalidate outstanding OTPs.
# OTP_HASH_SECRET=

# ---- Unsubscribe + GDPR erasure HMAC secrets (SECURITY) ---------------------
# Both are shared with the Cloudflare Worker (set the same value on both sides;
# `wrangler secret put UNSUBSCRIBE_TOKEN` / `ERASURE_SECRET`).
#
# UNSUBSCRIBE_TOKEN signs the `&token=<hmac>` appended to every unsubscribe link.
# The Worker fails CLOSED without it, so every unsubscribe link 400s and address
# suppression silently stops working.
#
# ERASURE_SECRET authenticates the Worker's internal call to
# `DELETE /api/gdpr/erasure/:patientId`. Without it that route returns 503, so
# GDPR erasure can never touch the live Postgres PHI. Treat a wrong value here as
# a compliance incident, not a configuration nuisance.
#
# Both fall back to INBOUND_EMAIL_SECRET if unset.
# UNSUBSCRIBE_TOKEN=
# ERASURE_SECRET=
# ---- Session lifetime (SECURITY) --------------------------------------------
# The session cookie used to be a flat 7 days with no idle bound and no absolute
# cap. For a PHI platform that is far too long. These are enforced SERVER-SIDE on
# every authenticated request — the browser's cookie expiry is not a control.
#
# SESSION_IDLE_TIMEOUT_MS — sliding window: extended by `rolling: true` on each
#   authenticated response. 30 minutes is the PHI-appropriate floor.
# SESSION_ABSOLUTE_TIMEOUT_MS — hard ceiling regardless of activity. 12 hours.
# Both return AUTH_SESSION_EXPIRED once exceeded, which the SPA surfaces as an
# explicit re-authentication prompt rather than a silent failure.
# SESSION_IDLE_TIMEOUT_MS=1800000
# SESSION_ABSOLUTE_TIMEOUT_MS=43200000
# How long a fresh password confirmation stays valid for step-up guards.
# REAUTH_MAX_AGE_MS=600000
# Secret used to derive the opaque `ref` returned by GET /sessions in place of
# the raw session id. Set independently of SESSION_SECRET so one can rotate.
# SESSION_REF_SECRET=

# ---- TOTP / MFA (SECURITY) ---------------------------------------------------
# AES-256-GCM key sealing the per-user TOTP shared secret at rest (32 bytes, hex
# or base64). REQUIRED IN PRODUCTION — derive from SESSION_SECRET only in dev.
# ROTATING IT INVALIDATES EVERY ENROLLED AUTHENTICATOR. The failure mode is
# deliberate and fail-closed: enrolments stop verifying (AUTH_TOTP_NOT_CONFIGURED)
# and users must fall back to a recovery code. Rotate only with a plan.
# MFA_ENCRYPTION_KEY=
# Issuer string shown inside the user's authenticator app. Brand only.
# MFA_ISSUER=MedResearch

# ---- Password reset ----------------------------------------------------------
# Salt for the reset-token digest. Defaults to OTP_HASH_SECRET then
# SESSION_SECRET; set it explicitly so rotating one does not invalidate
# outstanding reset links.
# RESET_TOKEN_HASH_SECRET=
# Where the emailed link points. Must be the real SPA route, and the route MUST
# exist in the public (signed-out) branch or the link lands nowhere.
# PASSWORD_RESET_URL=https://research-center.fit/reset-password
# DEVELOPMENT ONLY. When literally "true" AND NODE_ENV !== production, the reset
# response echoes the token in the body so the flow is testable without a mail
# server. MUST stay unset in production — leaving it on returns a working reset
# token to anyone who can call the endpoint.
# PASSWORD_RESET_DEV_TOKEN=
