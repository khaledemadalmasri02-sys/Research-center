# research-data (Vite SPA) build/dev configuration.
# The SPA itself reads almost nothing from the environment (only
# import.meta.env.BASE_URL / DEV, which Vite sets from the config), so the
# variables that matter here are the ones consumed by vite.config.ts.
#
# NOTE: this file is not read automatically by Vite. Export the values in your
# shell, or use `scripts/dev.sh` / `package.json` `dev:apps`, which set them.

# Port the dev server listens on. Repo-wide scheme: 4000 api-server,
# 4003 mockup-sandbox, 4004 research-data SPA (see README "Ports").
PORT=4004

# Host the dev server binds to. `pnpm dev` uses 0.0.0.0 (reachable from other
# devices on the LAN). Use 127.0.0.1 if the dev server must stay private.
HOST=0.0.0.0

# Base path the SPA is served under. `/` locally; the production Worker also
# uses `/`. Sub-path deployments need this to match the Worker route.
BASE_PATH=/

# Origin that /api/* requests are proxied to during `vite dev` (the
# vite.config.ts dev-server proxy target). Must be the api-server port from the
# repo-wide scheme, i.e. 4000.
API_PROXY_TARGET=http://localhost:4000

# The API server's S3 credentials, database URL, OAuth keys, SMTP settings and
# object prefixes are NOT read by this package — they belong to the api-server
# (see artifacts/api-server/.env.example).