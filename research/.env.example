# Research Worker environment configuration.
#
# These are Cloudflare Worker *bindings*, not process env vars: set secrets
# with `wrangler secret put <NAME> --env production`, and local-dev values in
# research/.dev.vars (git-ignored; research/.dev.vars.example is not tracked).
# The Worker's binding surface is typed in research/src/lib/env.ts.

# ---- /api/* proxy target ------------------------------------------------------
# API_BACKEND_URL is the single most important variable in this file and used
# to be documented NOWHERE, which meant a fresh clone deployed a Worker that
# 500s on every /api/* route ("API_BACKEND_URL is not configured").
# It is the origin the Worker reverse-proxies /api/* to — i.e. the tunnel
# hostname that scripts/research-deploy.sh points at this nginx proxy.
#   production: https://api.research-center.fit
#   local dev:  http://localhost:8080   (nginx :8080 -> api-server :4000)
# It must never end in a trailing slash (the Worker strips it).
# Set with:  pnpm -C research exec wrangler secret put --env production API_BACKEND_URL
API_BACKEND_URL=https://api.research-center.fit

# ---- Auth ---------------------------------------------------------------------
APP_USERNAME=admin
APP_PASSWORD_HASH=$2b$10$your-bcrypt-hash-here
# Session signing secret. Must be >= 32 bytes and DIFFERENT from the api-server
# SESSION_SECRET unless you intentionally share the session. Secret, not a var.
# SESSION_SECRET=your-session-secret-here

# ---- Object storage (S3/MinIO/R2) --------------------------------------------
# Optional: the Worker falls back to its own D1-backed routes for research
# features and only needs S3_* for direct object access. S3_FORCE_PATH_STYLE is
# required for MinIO and must be false for R2.
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_BUCKET=mednexus
S3_REGION=auto
# S3_FORCE_PATH_STYLE=true

# ---- D1 -----------------------------------------------------------------------
# These are declared in research/wrangler.toml; listed here for reference only.
# database_name: mednexus-research
# database_id: 83132b57-3fe6-4bec-bc90-b782fddcc2bc

# ---- Inbound email (Cloudflare Email Routing) --------------------------------
# Shared secret posted to the api-server's /api/inbound-email endpoint. Must
# match the api-server's INBOUND_EMAIL_SECRET. Set via:
#   wrangler secret put INBOUND_EMAIL_SECRET --env production
INBOUND_EMAIL_SECRET=

# Shared secret for the api-server's pre-send unsubscribe guard
# (/api/unsubscribe/status). Must match the api-server's
# MAIL_UNSUBSCRIBE_LOOKUP_TOKEN. Without it that endpoint is unauthenticated.
# Set via:  wrangler secret put --env production UNSUBSCRIBE_STATUS_TOKEN
# UNSUBSCRIBE_STATUS_TOKEN=

# ---- Optional: AI -------------------------------------------------------------
# Server-side voice/AI route key. A secret — never expose it to the browser.
# GROQ_API_KEY=