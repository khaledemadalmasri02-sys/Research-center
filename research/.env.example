# Research Worker Environment Configuration
# Uses same D1 database and S3 settings as dev/worker-api

# Auth
APP_USERNAME=admin
APP_PASSWORD_HASH=$2b$10$your-bcrypt-hash-here

# Session Secret - set via: wrangler secret put SESSION_SECRET
# SESSION_SECRET=your-session-secret-here

# MinIO/S3 Configuration (local dev - same as dev/worker-api)
# Set these as secrets for local dev:
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_BUCKET=mednexus
S3_REGION=auto

# D1 Database (same as dev/worker-api)
# database_name: mednexus-research
# database_id: 83132b57-3fe6-4bec-bc90-b782fddcc2bc

# ---- Inbound email (Cloudflare Email Routing) ------------------------------
# Shared secret posted to the api-server's /api/inbound-email endpoint. Must
# match the api-server's INBOUND_EMAIL_SECRET. Set via:
#   wrangler secret put INBOUND_EMAIL_SECRET --env production
INBOUND_EMAIL_SECRET=