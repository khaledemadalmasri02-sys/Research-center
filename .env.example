# Database Configuration
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=mednexus
DATABASE_URL=postgresql://postgres:postgres@postgres:5432/mednexus

# Server Configuration
PORT=3004
SESSION_SECRET=dev-secret-change-me
APP_USERNAME=admin
APP_PASSWORD_HASH=REDACTED_BCRYPT_HASH

# S3-Compatible Storage Configuration (MinIO)
S3_ENDPOINT=http://minio:9000
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_BUCKET=mednexus
S3_FORCE_PATH_STYLE=true
S3_SIGNED_URL_EXPIRES_SECONDS=300

# Object Storage Paths
PUBLIC_OBJECT_SEARCH_PATHS=radiology-public
PRIVATE_OBJECT_DIR=radiology-objects

# Frontend API URL
VITE_API_URL=http://localhost:3004/api

# Optional: File Upload Limits
MAX_IMAGE_SIZE_MB=100

# Local API Mock Storage URL (defaults to MinIO if not set)
# STORAGE_MOCK_URL=http://localhost:9000