# See https://docs.github.com/en/get-started/getting-started-with-git/ignoring-files for more about ignoring files.

# compiled output
dist
tmp
out-tsc
*.tsbuildinfo
.expo
.expo-shared

# dependencies
node_modules

# IDEs and editors
/.idea
.project
.classpath
.c9/
*.launch
.settings/
*.sublime-workspace

# IDE - VSCode
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json

# misc
/.sass-cache
/connect.lock
/coverage
/libpeerconnection.log
npm-debug.log
yarn-error.log
testem.log
/typings

# System Files
.DS_Store
Thumbs.db

.cursor/rules/nx-rules.mdc
.github/instructions/nx.instructions.md

# Replit
.cache/
.local/

# Local cloudflared tunnel token (secret) — optional fallback for pnpm run tunnel:run
research/.cloudflared-token

# Local environment / secrets — never commit
.env
.env.*
!.env.example
artifacts/api-server/.env
artifacts/local-api/.env
research/.env
research/.dev.vars
.replit
.replit.nix

# Wrangler local state (D1/KV SQLite, caches, observability) — never commit
research/.wrangler/
artifacts/**/*.wrangler/

# Build artefacts (rebuilt on every deploy)
/research/public/assets/*.js
/research/public/assets/*.css
/research/public/tour/*.mp4
/artifacts/research-data/public/tour/*.mp4
/artifacts/research-data/remotion/out/

# Attached assets — only synthetic fixtures belong in git (see attached_assets/fixtures/)
/attached_assets/*.xlsx
/attached_assets/*.png
/attached_assets/*.csv
/attached_assets/*.pdf
!/attached_assets/fixtures/

# Local githooks (already executable, but git config core.hooksPath uses them)
/.githooks/*.local
